# Stats & Progress Board Page (Parents/Teachers & Leaderboard)
<StatsPage>:
    BoxLayout:
        orientation: "vertical"
        padding: 10
        spacing: 10
        canvas.before:
            Color:
                rgba: (0.1, 0.12, 0.2, 1)
            Rectangle:
                pos: self.pos
                size: self.size

        # Top Header
        BoxLayout:
            orientation: "horizontal"
            size_hint_y: 0.08
            Button:
                text: "Back"
                size_hint_x: 0.2
                on_release:
                    app.root.current = "home"
                    app.root.transition.direction = "right"
            Label:
                text: "Progress Board & Leaderboard"
                font_size: '18sp'
                bold: True
                size_hint_x: 0.5
            Label:
                text: f"Coins: {root.user_coins}"
                size_hint_x: 0.3
                color: (1, 0.85, 0.2, 1)

        # Tabbed Data Area
        PageLayout:
            id: data_pages
