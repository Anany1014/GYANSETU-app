# Settings Page
<SettingsPage>:
    BoxLayout:
        orientation: "vertical"
        padding: 20
        spacing: 15
        canvas.before:
            Color:
                rgba: (0.1, 0.12, 0.2, 1)
            Rectangle:
                pos: self.pos
                size: self.size

        # Top Bar
        BoxLayout:
            orientation: "horizontal"
            size_hint_y: 0.1
            Button:
                text: "Back"
                size_hint_x: 0.2
                on_release:
                    app.root.current = "home"
                    app.root.transition.direction = "up"
            Label:
                text: "App Settings"
                font_size: '22sp'
                bold: True
                size_hint_x: 0.8

        # Language Select
        BoxLayout:
            orientation: "horizontal"
            size_hint_y: 0.15
            Label:
                text: "Select Local Language:"
                font_size: '16sp'
            Spinner:
                text: root.selected_lang
                values: ["English", "Punjabi (ਪੰਜਾਬੀ)", "Hindi (हिंदी)"]
                on_text: root.change_language(self.text)

        Button:
            text: "Reset Profile & Game Progress Data"
            font_size: '16sp'
            size_hint_y: 0.15
            background_normal: ""
            background_color: (0.8, 0.3, 0.2, 1)
            on_release: root.reset_progress()

        Button:
            text: "Exit GyanSetu App"
            font_size: '18sp'
            bold: True
            size_hint_y: 0.15
            background_normal: ""
            background_color: (0.6, 0.1, 0.1, 1)
            on_release: app.stop()

