#:kivy 2.3.0 
#:import SlideTransition kivy.uix.screenmanager.SlideTransition
#:import NoTransition kivy.uix.screenmanager.NoTransition

Manager:

<Manager>:
    HomePage:
        name: "home"
    CreateProfilePage:
        name: "create_profile"
    ProfilePage:
        name: "profile"
    HelpPage:
        name: "help"
    SettingsPage:
        name: "setting"
    StatsPage:
        name: "stats"
    BasicGamesPage:
        name: "Basic_Games"
    Basic_Math_Game_1:
        name: "Basic_Math_Game_1"
    MonkeyRiverGame:
        name: "Monkey_River_Game"
    LessonsPage:
        name: "lessons"
    GKQuizGame:
        name: "GK_Quiz_Game"
    EnglishVocabGame:
        name: "English_Vocab_Game"
    AchievementsPage:
        name: "achievements"
    GalleryPage:
        name: "gallery"
    RewardsPage:
        name: "rewards"
    StorePage:
        name: "store"

# First launch / Setup Profile Page
<CreateProfilePage>:
    BoxLayout:
        orientation: "vertical"
        padding: [30, 40, 30, 40]
        spacing: 20
        canvas.before:
            Color:
                rgba: (0.1, 0.12, 0.2, 1)
            Rectangle:
                pos: self.pos
                size: self.size
        
        Label:
            text: "Welcome to GyanSetu!"
            font_size: '28sp'
            bold: True
            color: (1, 0.85, 0.3, 1)
            size_hint_y: 0.2

        Label:
            text: "Create Your Rural Scholar Profile"
            font_size: '18sp'
            color: (0.9, 0.9, 0.9, 1)
            size_hint_y: 0.1

        TextInput:
            id: name_in
            hint_text: "Enter Student Name"
            font_size: '20sp'
            multiline: False
            size_hint_y: 0.12
            on_text: root.user_name = self.text

        BoxLayout:
            orientation: "horizontal"
            size_hint_y: 0.15
            spacing: 15
            Label:
                text: "Select Class (1-10):"
                font_size: '16sp'
                size_hint_x: 0.5
            Spinner:
                text: "Class 6"
                values: [f"Class {i}" for i in range(1, 11)]
                size_hint_x: 0.5
                on_text: root.selected_class = int(self.text.split()[1])

        Button:
            text: "Start Learning Now!"
            font_size: '20sp'
            bold: True
            background_normal: ""
            background_color: (0.15, 0.7, 0.35, 1)
            size_hint_y: 0.15
            on_release: root.save_profile()

# Home Page Screen
<HomePage>:
    FloatLayout:
        # App Header Bar
        BoxLayout:
            orientation: "horizontal"
            size_hint: 1, 0.08
            pos_hint: {"top": 1}
            padding: [10, 5, 10, 5]
            canvas.before:
                Color:
                    rgba: (0.12, 0.16, 0.28, 1)
                Rectangle:
                    pos: self.pos
                    size: self.size

            # Profile Summary Button
            Button:
                size_hint_x: 0.35
                background_normal: ""
                background_color: (0.2, 0.25, 0.4, 1)
                text: f"{root.user_name} (Lvl {root.user_level})"
                bold: True
                font_size: '14sp'
                on_release:
                    app.root.current = "profile"
                    app.root.transition.direction = "down"

            # Coins Tracker Display
            Label:
                size_hint_x: 0.35
                text: f"Coins: {root.user_coins}"
                font_size: '16sp'
                bold: True
                color: (1, 0.85, 0.2, 1)

            # Settings Button
            Button:
                size_hint_x: 0.15
                background_normal: "logos/settings.png"
                border: [0,0,0,0]
                on_release:
                    app.root.current = "setting"
                    app.root.transition.direction = "down"

            # Help Button
            Button:
                size_hint_x: 0.15
                background_normal: "logos/help.png"
                border: [0,0,0,0]
                on_release:
                    app.root.current = "help"
                    app.root.transition.direction = "down"

        # Main Central Banner Graphic
        BoxLayout:
            orientation: "vertical"
            size_hint: 0.9, 0.45
            pos_hint: {"center_x": 0.5, "center_y": 0.55}
            padding: 15
            canvas.before:
                Color:
                    rgba: (0.18, 0.22, 0.35, 0.9)
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [15,]

            Label:
                text: f"GyanSetu Digital Learning Platform"
                font_size: '22sp'
                bold: True
                color: (1, 0.85, 0.3, 1)

            Label:
                text: f"Title: {root.user_title}"
                font_size: '16sp'
                color: (0.8, 0.9, 1, 1)

            Label:
                text: "Gamified Offline Education for Classes 1–10"
                font_size: '14sp'
                color: (0.7, 0.8, 0.9, 1)

        # Quick Access Side Menu Left (Achievements & Gallery)
        BoxLayout:
            orientation: "vertical"
            size_hint: 0.22, 0.25
            pos_hint: {"x": 0.05, "y": 0.2}
            spacing: 10

            Button:
                background_normal: "logos/achievements.png"
                border: [0,0,0,0]
                on_release:
                    app.root.current = "achievements"
                    app.root.transition.direction = "right"

            Button:
                background_normal: "logos/gallery.png"
                border: [0,0,0,0]
                on_release:
                    app.root.current = "gallery"
                    app.root.transition.direction = "right"

        # Quick Access Side Menu Right (Stats, Store & Daily Rewards)
        BoxLayout:
            orientation: "vertical"
            size_hint: 0.22, 0.36
            pos_hint: {"right": 0.95, "y": 0.2}
            spacing: 10

            Button:
                background_normal: "logos/stats.png"
                border: [0,0,0,0]
                on_release:
                    app.root.current = "stats"
                    app.root.transition.direction = "left"

            Button:
                background_normal: "logos/store.png"
                border: [0,0,0,0]
                on_release:
                    app.root.current = "store"
                    app.root.transition.direction = "left"

            Button:
                background_normal: "logos/tasks.png"
                border: [0,0,0,0]
                on_release:
                    app.root.current = "rewards"
                    app.root.transition.direction = "left"

        # Navigation Bar (Basic Games, Lessons, Other Games)
        BoxLayout:
            orientation: "horizontal"
            size_hint: 1, 0.15
            pos_hint: {"x": 0, "y": 0}
            padding: 5
            spacing: 5
            canvas.before:
                Color:
                    rgba: (0.1, 0.12, 0.2, 1)
                Rectangle:
                    pos: self.pos
                    size: self.size

            Button:
                background_normal: "logos/basic game.png"
                border: [0,0,0,0]
                on_release:
                    app.root.current = "Basic_Games"
                    app.root.transition.direction = "up"

            Button:
                background_normal: "logos/lessons.png"
                border: [0,0,0,0]
                on_release:
                    app.root.current = "lessons"
                    app.root.transition.direction = "up"

            Button:
                background_normal: "logos/other games.png"
                border: [0,0,0,0]
                on_release:
                    app.root.current = "lessons"
                    app.root.transition.direction = "up"

# Profile Screen
<ProfilePage>:
    BoxLayout:
        orientation: "vertical"
        padding: 20
        spacing: 15
        canvas.before:
            Color:
                rgba: (0.12, 0.15, 0.25, 1)
            Rectangle:
                pos: self.pos
                size: self.size

        # Header
        BoxLayout:
            orientation: "horizontal"
            size_hint_y: 0.1
            Button:
                text: "Back"
                size_hint_x: 0.2
                on_release:
                    app.root.current = "home"
                    app.root.transition.direction = "up"
            Label:
                text: "Student Profile"
                font_size: '22sp'
                bold: True
                size_hint_x: 0.8

        # Profile Card
        BoxLayout:
            orientation: "vertical"
            size_hint_y: 0.6
            padding: 15
            spacing: 10
            canvas.before:
                Color:
                    rgba: (0.2, 0.25, 0.4, 1)
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [12,]

            Label:
                text: f"UID: {root.user_uid}"
                font_size: '16sp'
                color: (1, 0.85, 0.3, 1)

            TextInput:
                id: name_edit
                text: root.user_name
                font_size: '18sp'
                multiline: False
                size_hint_y: 0.25

            BoxLayout:
                orientation: "horizontal"
                size_hint_y: 0.25
                Label:
                    text: "Class Level:"
                    font_size: '16sp'
                Spinner:
                    id: class_spin
                    text: f"Class {root.user_class}"
                    values: [f"Class {i}" for i in range(1, 11)]

            Label:
                text: f"Title: {root.user_title}"
                font_size: '16sp'
                color: (0.8, 0.9, 1, 1)

            Label:
                text: f"Coins Accumulated: {root.user_coins}"
                font_size: '16sp'
                color: (1, 0.85, 0.2, 1)

            Label:
                text: f"Achievements Unlocked: {root.achievements_count}"
                font_size: '16sp'

        Button:
            text: "Save Profile Changes"
            font_size: '18sp'
            bold: True
            size_hint_y: 0.15
            background_normal: ""
            background_color: (0.15, 0.7, 0.35, 1)
            on_release:
                root.save_changes(name_edit.text, class_spin.text.split()[-1])

# Basic Games Arcade Screen
<BasicGamesPage>:
    BoxLayout:
        orientation: "vertical"
        padding: 15
        spacing: 10
        canvas.before:
            Color:
                rgba: (0.1, 0.12, 0.22, 1)
            Rectangle:
                pos: self.pos
                size: self.size

        # Top Header
        BoxLayout:
            orientation: "horizontal"
            size_hint_y: 0.1
            Button:
                text: "Back"
                size_hint_x: 0.2
                on_release:
                    app.root.current = "home"
                    app.root.transition.direction = "down"
            Label:
                text: "Basic Arcade Games"
                font_size: '20sp'
                bold: True
                size_hint_x: 0.6
            Label:
                text: f"Coins: {root.user_coins}"
                size_hint_x: 0.2
                color: (1, 0.85, 0.2, 1)

        # Games Selection List
        ScrollView:
            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                spacing: 15
                padding: 10

                # Game 1: Knight vs Dragon Arithmetic Battle
                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: 160
                    padding: 10
                    spacing: 5
                    canvas.before:
                        Color:
                            rgba: (0.18, 0.24, 0.38, 1)
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [10,]

                    Label:
                        text: "Knight vs Dragon (Math Arithmetic Combat)"
                        font_size: '18sp'
                        bold: True
                        color: (1, 0.85, 0.3, 1)

                    Label:
                        text: "Answer questions to strike the dragon before it auto-attacks!"
                        font_size: '14sp'

                    BoxLayout:
                        orientation: "horizontal"
                        spacing: 10
                        Button:
                            text: "Easy Mode"
                            background_color: (0.2, 0.7, 0.3, 1)
                            on_release: root.launch_game("Basic_Math_Game_1", "Easy")
                        Button:
                            text: "Medium Mode"
                            background_color: (0.9, 0.6, 0.2, 1)
                            on_release: root.launch_game("Basic_Math_Game_1", "Medium")
                        Button:
                            text: "Hard Mode"
                            background_color: (0.8, 0.2, 0.2, 1)
                            on_release: root.launch_game("Basic_Math_Game_1", "Hard")

                # Game 2: Help Monkey Cross River Puzzle
                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: 160
                    padding: 10
                    spacing: 5
                    canvas.before:
                        Color:
                            rgba: (0.18, 0.24, 0.38, 1)
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [10,]

                    Label:
                        text: "Monkey River Crossing (Problem Solving)"
                        font_size: '18sp'
                        bold: True
                        color: (1, 0.85, 0.3, 1)

                    Label:
                        text: "Solve math stepping stones to guide the monkey across!"
                        font_size: '14sp'

                    BoxLayout:
                        orientation: "horizontal"
                        spacing: 10
                        Button:
                            text: "Play Puzzle Game"
                            background_color: (0.15, 0.6, 0.8, 1)
                            on_release: root.launch_game("Monkey_River_Game", "Easy")

# Game 1 Screen: Knight vs Dragon Math Battle
<Basic_Math_Game_1>:
    BoxLayout:
        orientation: "vertical"
        canvas.before:
            Color:
                rgba: (0.08, 0.1, 0.18, 1)
            Rectangle:
                pos: self.pos
                size: self.size

        # Top Bar
        BoxLayout:
            orientation: "horizontal"
            size_hint_y: 0.08
            padding: 5
            canvas.before:
                Color:
                    rgba: (0.15, 0.2, 0.35, 1)
                Rectangle:
                    pos: self.pos
                    size: self.size

            Label:
                text: f"Mode: {root.difficulty}"
                size_hint_x: 0.3
                font_size: '14sp'

            Label:
                text: f"Points: {root.points}"
                size_hint_x: 0.5
                font_size: '16sp'
                bold: True
                color: (1, 0.85, 0.2, 1)

            Button:
                text: "Exit Game"
                size_hint_x: 0.2
                background_normal: ""
                background_color: (0.8, 0.2, 0.2, 1)
                on_release: root.return_to_menu()

        # Battle Animation & Health Bar View
        BoxLayout:
            orientation: "horizontal"
            size_hint_y: 0.38
            padding: 15
            spacing: 20

            # Knight Side
            BoxLayout:
                orientation: "vertical"
                size_hint_x: 0.45
                Label:
                    text: "HERO KNIGHT"
                    bold: True
                    font_size: '16sp'
                    color: (0.3, 0.8, 1, 1)
                ProgressBar:
                    max: root.hero_max_hp
                    value: root.hero_hp
                    size_hint_y: 0.25
                Label:
                    text: f"HP: {root.hero_hp}/{root.hero_max_hp}"
                    font_size: '14sp'

            # Dragon Side
            BoxLayout:
                orientation: "vertical"
                size_hint_x: 0.45
                Label:
                    text: "FIRE DRAGON"
                    bold: True
                    font_size: '16sp'
                    color: (1, 0.3, 0.3, 1)
                ProgressBar:
                    max: root.dragon_max_hp
                    value: root.dragon_hp
                    size_hint_y: 0.25
                Label:
                    text: f"HP: {root.dragon_hp}/{root.dragon_max_hp}"
                    font_size: '14sp'

        # Status Message
        Label:
            text: root.status_msg
            font_size: '16sp'
            bold: True
            color: (1, 0.9, 0.4, 1)
            size_hint_y: 0.08

        # Question & Answer Display Bar
        BoxLayout:
            orientation: "horizontal"
            size_hint_y: 0.12
            padding: 10
            spacing: 10
            canvas.before:
                Color:
                    rgba: (0.95, 0.95, 0.95, 1)
                Rectangle:
                    pos: self.pos
                    size: self.size

            Label:
                text: root.ques_text
                font_size: '24sp'
                bold: True
                color: (0, 0, 0, 1)
                size_hint_x: 0.45

            Label:
                text: "="
                font_size: '24sp'
                color: (0, 0, 0, 1)
                size_hint_x: 0.1

            Label:
                text: root.ans_text
                font_size: '24sp'
                bold: True
                color: (0, 0.5, 0.8, 1)
                size_hint_x: 0.3

            Button:
                text: "Del"
                font_size: '16sp'
                size_hint_x: 0.15
                background_color: (0.7, 0.2, 0.2, 1)
                on_release: root.delete()

        # On-Screen Keypad
        BoxLayout:
            orientation: "horizontal"
            size_hint_y: 0.34
            padding: 5
            spacing: 5

            GridLayout:
                cols: 3
                size_hint_x: 0.75
                spacing: 5

                Button:
                    text: "1"
                    font_size: '22sp'
                    on_release: root.keypad("1")
                Button:
                    text: "2"
                    font_size: '22sp'
                    on_release: root.keypad("2")
                Button:
                    text: "3"
                    font_size: '22sp'
                    on_release: root.keypad("3")
                Button:
                    text: "4"
                    font_size: '22sp'
                    on_release: root.keypad("4")
                Button:
                    text: "5"
                    font_size: '22sp'
                    on_release: root.keypad("5")
                Button:
                    text: "6"
                    font_size: '22sp'
                    on_release: root.keypad("6")
                Button:
                    text: "7"
                    font_size: '22sp'
                    on_release: root.keypad("7")
                Button:
                    text: "8"
                    font_size: '22sp'
                    on_release: root.keypad("8")
                Button:
                    text: "9"
                    font_size: '22sp'
                    on_release: root.keypad("9")
                Button:
                    text: "+/-"
                    font_size: '18sp'
                    on_release: root.uni_opera()
                Button:
                    text: "0"
                    font_size: '22sp'
                    on_release: root.keypad("0")
                Button:
                    text: "."
                    font_size: '22sp'
                    on_release: root.keypad(".")

            Button:
                text: "ATTACK\n(ENTER)"
                font_size: '18sp'
                bold: True
                size_hint_x: 0.25
                background_normal: ""
                background_color: (0.15, 0.7, 0.3, 1)
                on_release: root.enter()

# Game 2 Screen: Monkey River Crossing
<MonkeyRiverGame>:
    BoxLayout:
        orientation: "vertical"
        padding: 15
        spacing: 15
        canvas.before:
            Color:
                rgba: (0.05, 0.15, 0.25, 1)
            Rectangle:
                pos: self.pos
                size: self.size

        # Top Bar
        BoxLayout:
            orientation: "horizontal"
            size_hint_y: 0.1
            Button:
                text: "Exit"
                size_hint_x: 0.2
                on_release: root.exit_game()
            Label:
                text: "Monkey River Crossing"
                font_size: '20sp'
                bold: True
                size_hint_x: 0.5
            Label:
                text: f"Score: {root.score}"
                size_hint_x: 0.3
                color: (1, 0.85, 0.2, 1)

        # Question Banner
        Label:
            text: root.question_text
            font_size: '22sp'
            bold: True
            color: (1, 0.9, 0.4, 1)
            size_hint_y: 0.2

        Label:
            text: root.status_msg
            font_size: '16sp'
            color: (0.8, 0.9, 1, 1)
            size_hint_y: 0.1

        # Stepping Stones (4 choices)
        GridLayout:
            cols: 2
            size_hint_y: 0.6
            spacing: 15
            padding: 10

            Button:
                text: f"Stone 1: {root.stone_1}"
                font_size: '20sp'
                bold: True
                background_color: (0.2, 0.5, 0.7, 1)
                on_release: root.select_stone(1)
            Button:
                text: f"Stone 2: {root.stone_2}"
                font_size: '20sp'
                bold: True
                background_color: (0.2, 0.5, 0.7, 1)
                on_release: root.select_stone(2)
            Button:
                text: f"Stone 3: {root.stone_3}"
                font_size: '20sp'
                bold: True
                background_color: (0.2, 0.5, 0.7, 1)
                on_release: root.select_stone(3)
            Button:
                text: f"Stone 4: {root.stone_4}"
                font_size: '20sp'
                bold: True
                background_color: (0.2, 0.5, 0.7, 1)
                on_release: root.select_stone(4)

# Lessons Screen (Class 1-10 Dynamic Curriculum)
<LessonsPage>:
    BoxLayout:
        orientation: "vertical"
        padding: 10
        spacing: 10
        canvas.before:
            Color:
                rgba: (0.1, 0.12, 0.2, 1)
            Rectangle:
                pos: self.pos
                size: self.size

        # Top Header
        BoxLayout:
            orientation: "horizontal"
            size_hint_y: 0.08
            Button:
                text: "Home"
                size_hint_x: 0.2
                on_release:
                    app.root.current = "home"
                    app.root.transition.direction = "down"
            Label:
                text: f"Curriculum Lessons (Class {root.selected_class})"
                font_size: '18sp'
                bold: True
                size_hint_x: 0.6
            Label:
                text: f"Coins: {root.user_coins}"
                size_hint_x: 0.2
                color: (1, 0.85, 0.2, 1)

        # Class Selector Bar (Class 1 to 10)
        ScrollView:
            size_hint_y: 0.1
            do_scroll_y: False
            BoxLayout:
                orientation: "horizontal"
                size_hint_x: None
                width: self.minimum_width
                spacing: 8
                padding: 2

                Button:
                    text: "Class 1"
                    size_hint_x: None
                    width: 90
                    on_release: root.select_class(1)
                Button:
                    text: "Class 2"
                    size_hint_x: None
                    width: 90
                    on_release: root.select_class(2)
                Button:
                    text: "Class 3"
                    size_hint_x: None
                    width: 90
                    on_release: root.select_class(3)
                Button:
                    text: "Class 4"
                    size_hint_x: None
                    width: 90
                    on_release: root.select_class(4)
                Button:
                    text: "Class 5"
                    size_hint_x: None
                    width: 90
                    on_release: root.select_class(5)
                Button:
                    text: "Class 6"
                    size_hint_x: None
                    width: 90
                    on_release: root.select_class(6)
                Button:
                    text: "Class 7"
                    size_hint_x: None
                    width: 90
                    on_release: root.select_class(7)
                Button:
                    text: "Class 8"
                    size_hint_x: None
                    width: 90
                    on_release: root.select_class(8)
                Button:
                    text: "Class 9"
                    size_hint_x: None
                    width: 90
                    on_release: root.select_class(9)
                Button:
                    text: "Class 10"
                    size_hint_x: None
                    width: 90
                    on_release: root.select_class(10)

        # Subject Tab Buttons
        BoxLayout:
            orientation: "horizontal"
            size_hint_y: 0.08
            spacing: 5
            Button:
                text: "Maths"
                background_color: (0.2, 0.6, 0.9, 1)
                on_release: root.select_subject("Maths")
            Button:
                text: "Science"
                background_color: (0.2, 0.7, 0.4, 1)
                on_release: root.select_subject("Science")
            Button:
                text: "English"
                background_color: (0.8, 0.4, 0.8, 1)
                on_release: root.select_subject("English")
            Button:
                text: "GK"
                background_color: (0.9, 0.6, 0.2, 1)
                on_release: root.select_subject("GK")

        # Dynamic Chapters & Games Browser List
        ScrollView:
            size_hint_y: 0.74
            BoxLayout:
                id: chapters_box
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                spacing: 12
                padding: 10

                # Render dynamic chapter buttons
                Button:
                    text: "Launch Chapter 1 Interactive Lesson"
                    size_hint_y: None
                    height: 70
                    font_size: '16sp'
                    background_color: (0.2, 0.3, 0.5, 1)
                    on_release: root.start_chapter_game("kvd")

                Button:
                    text: "Launch Chapter 2 Problem Solving Game"
                    size_hint_y: None
                    height: 70
                    font_size: '16sp'
                    background_color: (0.2, 0.3, 0.5, 1)
                    on_release: root.start_chapter_game("monkey")

# GK Quiz Screen
<GKQuizGame>:
    BoxLayout:
        orientation: "vertical"
        padding: 15
        spacing: 15
        canvas.before:
            Color:
                rgba: (0.1, 0.15, 0.22, 1)
            Rectangle:
                pos: self.pos
                size: self.size

        # Top Bar
        BoxLayout:
            orientation: "horizontal"
            size_hint_y: 0.08
            Button:
                text: "Back"
                size_hint_x: 0.2
                on_release: root.exit_quiz()
            Label:
                text: root.question_title
                font_size: '18sp'
                bold: True
                size_hint_x: 0.5
            Label:
                text: f"Score: {root.score}"
                size_hint_x: 0.3
                color: (1, 0.85, 0.2, 1)

        # Question text
        Label:
            text: root.question_text
            font_size: '20sp'
            bold: True
            color: (1, 0.9, 0.4, 1)
            size_hint_y: 0.25

        Label:
            text: root.explanation
            font_size: '14sp'
            color: (0.7, 0.9, 1, 1)
            size_hint_y: 0.12

        # 4 Options Buttons
        GridLayout:
            cols: 1
            size_hint_y: 0.55
            spacing: 10

            Button:
                text: f"A) {root.option_a}"
                font_size: '16sp'
                background_color: (0.2, 0.3, 0.5, 1)
                on_release: root.choose_option(0)
            Button:
                text: f"B) {root.option_b}"
                font_size: '16sp'
                background_color: (0.2, 0.3, 0.5, 1)
                on_release: root.choose_option(1)
            Button:
                text: f"C) {root.option_c}"
                font_size: '16sp'
                background_color: (0.2, 0.3, 0.5, 1)
                on_release: root.choose_option(2)
            Button:
                text: f"D) {root.option_d}"
                font_size: '16sp'
                background_color: (0.2, 0.3, 0.5, 1)
                on_release: root.choose_option(3)

# English Vocab & Pronunciation Screen
<EnglishVocabGame>:
    BoxLayout:
        orientation: "vertical"
        padding: 15
        spacing: 15
        canvas.before:
            Color:
                rgba: (0.15, 0.1, 0.25, 1)
            Rectangle:
                pos: self.pos
                size: self.size

        # Top Bar
        BoxLayout:
            orientation: "horizontal"
            size_hint_y: 0.08
            Button:
                text: "Back"
                size_hint_x: 0.2
                on_release: root.exit_game()
            Label:
                text: "English Vocabulary Master"
                font_size: '18sp'
                bold: True
                size_hint_x: 0.5
            Label:
                text: f"Score: {root.score}"
                size_hint_x: 0.3
                color: (1, 0.85, 0.2, 1)

        # Word Display & TTS Button
        BoxLayout:
            orientation: "horizontal"
            size_hint_y: 0.2
            spacing: 15
            padding: 10
            canvas.before:
                Color:
                    rgba: (0.25, 0.18, 0.38, 1)
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [10,]

            Label:
                text: root.word_text
                font_size: '24sp'
                bold: True
                color: (1, 0.85, 0.3, 1)

            Button:
                text: "Listen Audio"
                size_hint_x: 0.35
                font_size: '14sp'
                background_color: (0.6, 0.3, 0.8, 1)
                on_release: root.play_audio()

        Label:
            text: root.definition_text
            font_size: '18sp'
            size_hint_y: 0.15

        Label:
            text: root.status_msg
            font_size: '14sp'
            color: (0.8, 0.9, 1, 1)
            size_hint_y: 0.1

        # Vocabulary Options
        BoxLayout:
            orientation: "vertical"
            size_hint_y: 0.47
            spacing: 10

            Button:
                text: root.opt1
                font_size: '16sp'
                background_color: (0.3, 0.2, 0.45, 1)
                on_release: root.check_answer(0)
            Button:
                text: root.opt2
                font_size: '16sp'
                background_color: (0.3, 0.2, 0.45, 1)
                on_release: root.check_answer(1)
            Button:
                text: root.opt3
                font_size: '16sp'
                background_color: (0.3, 0.2, 0.45, 1)
                on_release: root.check_answer(2)

# Achievements Screen
<AchievementsPage>:
